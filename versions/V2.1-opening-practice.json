    "ffaa": "0x0C",
    "ffad": "0x00",
    "ffae": "0x00",
    "c4f0_c4f2": "00 00 00",
    "v1_fallback_bytes": "F1 FE 60 D2 15 18 C3 07 18",
    "v2_1_fix": "Use a 9-byte stub at 0x00E0 and a 13-byte completion at 0x00E9; preserve the fallback at 0x00F7."
  },
  "confirmed_root_cause": {
    "location": "bank 0x30 gateway, CPU address 0x4000",
    "finding": "The gateway restored bank 0x04 at 0x4007, then continued executing from 0x400A inside the banked ROM window. Subsequent opcodes were fetched from bank 0x24 instead of the gateway code in bank 0x30, causing invalid control flow before fixed completion.",
    "evidence": [
      "The loader and dispatcher completed successfully; C4F0=BB and C4F2=80.",
      "The trace reached the bank-0x30 gateway, but did not reach the fixed completion stub.",
      "SameBoy stopped at PC 0x4083 in the bank-0x24 data/pointer region."
    ],
    "resolution": "V2.2 calls the bank-0x30 gateway while still in fixed bank code, returns from the gateway before restoring the original bank, and handles the result in a fixed-bank return stub."
  },
